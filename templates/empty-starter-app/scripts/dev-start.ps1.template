param([switch]$SkipSkill, [switch]$Clean)

$ErrorActionPreference = "Stop"
$Root = Split-Path -Parent $PSScriptRoot
$ForceClean = $Clean.IsPresent -or ($env:FORCE_CLEAN -eq "1")
$RunDir = Join-Path $Root ".dev-run"
. (Join-Path $PSScriptRoot "load-ports.ps1")
Import-AppPorts $Root
$RawSkillName = "__SKILL_NAME__"
$SkillName = if ([string]::IsNullOrWhiteSpace($RawSkillName) -or $RawSkillName.StartsWith("__SKILL")) { "text-insights" } else { $RawSkillName }
$AgentPort = if ($env:AGENT_PORT) { [int]$env:AGENT_PORT } else { 8088 }
$WebPort = if ($env:WEB_PORT) { [int]$env:WEB_PORT } else { 3000 }
$SkillPort = Get-SkillPort $SkillName 0 $true
$env:AGENT_PORT = "$AgentPort"
$env:WEB_PORT = "$WebPort"
$env:SKILL_PORT = "$SkillPort"
$env:AGENT_URL = "http://127.0.0.1:$AgentPort"
if (-not $env:MCP_SKILL_URL) {
  $env:MCP_SKILL_URL = "http://127.0.0.1:$SkillPort/runtime/webhooks/mcp"
}
& (Join-Path $PSScriptRoot "dev-stop.ps1") | Out-Null
if ($LASTEXITCODE -ne 0) { throw "The previous app processes could not be stopped safely." }
New-Item -ItemType Directory -Force -Path $RunDir | Out-Null
Remove-Item Env:UV_FROZEN, Env:UV_LOCKED, Env:UV_NO_SYNC, Env:UV_OFFLINE -ErrorAction SilentlyContinue
$IndexUrl = if ($env:PIP_INDEX_URL) { $env:PIP_INDEX_URL } elseif ($env:UV_INDEX_URL) { $env:UV_INDEX_URL } else { $env:UV_DEFAULT_INDEX }
if (-not $IndexUrl -and (Get-Command python -ErrorAction SilentlyContinue)) {
  $ConfiguredIndex = & python -m pip config get global.index-url 2>$null
  if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($ConfiguredIndex)) { $IndexUrl = $ConfiguredIndex.Trim() }
}
if ($IndexUrl) {
  Remove-Item Env:PIP_EXTRA_INDEX_URL, Env:UV_EXTRA_INDEX_URL -ErrorAction SilentlyContinue
  $env:PIP_INDEX_URL = $env:UV_INDEX_URL = $env:UV_DEFAULT_INDEX = $IndexUrl
}

foreach ($envCandidate in @((Join-Path $Root ".env"), (Join-Path $Root "src/agent/.env"))) {
  if (Test-Path $envCandidate) {
    foreach ($line in Get-Content $envCandidate) {
      if ($line -match '^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$') {
        $k = $Matches[1]
        $v = $Matches[2].Trim().Trim('"').Trim("'")
        if ($v) { [Environment]::SetEnvironmentVariable($k, $v, "Process") }
      }
    }
    break
  }
}

function Wait-Health($Name, $Port, $Route, $Process) {
  $lastError = "No HTTP response."
  for ($i = 0; $i -lt 200; $i++) {
    if ($Process.HasExited) { throw "$Name exited before becoming ready. See .dev-run/$Name.err.log." }
    try {
      $response = Invoke-WebRequest "http://127.0.0.1:$Port$Route" -UseBasicParsing -SkipHttpErrorCheck -TimeoutSec 2
      if ($response.StatusCode -eq 200) {
        Write-Host "[$Name] READY on port $Port"
        return
      }
      $lastError = "HTTP $($response.StatusCode)"
    } catch {
      $lastError = $_.Exception.Message
    }
    Start-Sleep -Milliseconds 150
  }
  throw "$Name did not become ready on port $Port`: $lastError. See .dev-run/$Name.err.log."
}

$StateFile = Join-Path $RunDir "processes.json"
function Read-ProcessState {
  if (-not (Test-Path -LiteralPath $StateFile)) { return @() }
  $raw = Get-Content -LiteralPath $StateFile -Raw
  if ([string]::IsNullOrWhiteSpace($raw)) { return @() }
  return @($raw | ConvertFrom-Json)
}
function Save-ProcessRecord($Record) {
  $items = @(Read-ProcessState | Where-Object { $_.name -ne $Record.name })
  $items += $Record
  @($items) | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath $StateFile
}
function Register-TrackedProcess($Name, $Port, $Process) {
  $record = [pscustomobject]@{ name = $Name; port = $Port; pid = $Process.Id; startedAt = $null }
  Save-ProcessRecord $record
  try { $record.startedAt = $Process.StartTime.ToUniversalTime().ToString("O") }
  catch { throw "Could not record process identity for $Name. Verify PID $($Process.Id) manually." }
  Save-ProcessRecord $record
}
try {
  if (-not (Get-Command uv -ErrorAction SilentlyContinue)) { throw "uv is required." }
  $SkillDir = Join-Path $Root "src/skills/$SkillName"
  if (-not (Test-Path -LiteralPath $SkillDir) -and (Test-Path -LiteralPath (Join-Path $Root "src/skills/__SKILL__"))) {
    $SkillDir = Join-Path $Root "src/skills/__SKILL__"
  }
  if ($SkipSkill) {
    Write-Host "Hosted Skill skipped (-SkipSkill)."
  } else {
    $McpStartScript = Join-Path $PSScriptRoot "lifecycle/mcp-skill-start.ps1"
    $McpArgs = @{
      Name   = $SkillName
      Path   = $SkillDir
      Port   = $SkillPort
      RunDir = $RunDir
    }
    if ($ForceClean) { $McpArgs["Clean"] = $true }
    & $McpStartScript @McpArgs
    if ($LASTEXITCODE -ne 0) {
      throw "MCP Hosted Skill '$SkillName' failed to start on port $SkillPort."
    }
  }
  $AgentDir = Join-Path $Root "src/agent"
  if ($ForceClean -and (Test-Path (Join-Path $AgentDir ".venv"))) {
    Remove-Item -Recurse -Force (Join-Path $AgentDir ".venv")
  }
  $agent = Start-Process uv -ArgumentList "run", "main.py" -WorkingDirectory $AgentDir -WindowStyle Hidden -PassThru `
    -RedirectStandardOutput (Join-Path $RunDir "agent.log") -RedirectStandardError (Join-Path $RunDir "agent.err.log")
  Register-TrackedProcess "agent" $AgentPort $agent
  Wait-Health "agent" $AgentPort "/health" $agent
  $web = Start-Process npm.cmd -ArgumentList "run", "dev" -WorkingDirectory (Join-Path $Root "src/web") -WindowStyle Hidden -PassThru `
    -RedirectStandardOutput (Join-Path $RunDir "web.log") -RedirectStandardError (Join-Path $RunDir "web.err.log")
  Register-TrackedProcess "web" $WebPort $web
  Wait-Health "web" $WebPort "/" $web
  Write-Host "__APP_NAME__ started: web http://localhost:$WebPort, agent http://localhost:$AgentPort, mcp-skill $($env:MCP_SKILL_URL)"
} catch {
  & (Join-Path $PSScriptRoot "dev-stop.ps1")
  throw
}
