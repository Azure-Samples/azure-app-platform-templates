param([switch]$SkipSkill, [switch]$Clean)
$ErrorActionPreference = "Stop"

$Root = Split-Path -Parent $PSScriptRoot
$ForceClean = $Clean.IsPresent -or ($env:FORCE_CLEAN -eq "1")
$RunDir = Join-Path $Root ".dev-run"
. (Join-Path $PSScriptRoot "load-ports.ps1")
Import-AppPorts $Root
$WebPort = if ($env:WEB_PORT) { [int]$env:WEB_PORT } else { 8080 }
$AgentPort = if ($env:AGENT_PORT) { [int]$env:AGENT_PORT } else { 8088 }

& (Join-Path $PSScriptRoot "dev-stop.ps1") | Out-Null
if ($LASTEXITCODE -ne 0) { throw "The previous app processes could not be stopped safely." }
New-Item -ItemType Directory -Force -Path $RunDir | Out-Null

$IndexUrl = if ($env:PIP_INDEX_URL) { $env:PIP_INDEX_URL } elseif ($env:UV_INDEX_URL) { $env:UV_INDEX_URL } else { $env:UV_DEFAULT_INDEX }
if (-not $IndexUrl -and (Get-Command python -ErrorAction SilentlyContinue)) {
  $ConfiguredIndex = & python -m pip config get global.index-url 2>$null
  if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($ConfiguredIndex)) { $IndexUrl = $ConfiguredIndex.Trim() }
}
if ($IndexUrl) { $env:PIP_INDEX_URL = $env:UV_INDEX_URL = $env:UV_DEFAULT_INDEX = $IndexUrl }

foreach ($envCandidate in @((Join-Path $Root ".env"), (Join-Path $Root "src/agent/.env"))) {
  if (Test-Path $envCandidate) {
    foreach ($line in Get-Content $envCandidate) {
      if ($line -match '^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$') {
        $k = $Matches[1]
        $v = $Matches[2].Trim().Trim('"').Trim("'")
        if ($v) { [Environment]::SetEnvironmentVariable($k, $v, "Process") }
      }
    }
    break
  }
}

$StateFile = Join-Path $RunDir "processes.json"
function Read-ProcessState {
  if (-not (Test-Path -LiteralPath $StateFile)) { return @() }
  $raw = Get-Content -LiteralPath $StateFile -Raw
  if ([string]::IsNullOrWhiteSpace($raw)) { return @() }
  return @($raw | ConvertFrom-Json)
}
function Save-ProcessRecord($Record) {
  $items = @(Read-ProcessState | Where-Object { $_.name -ne $Record.name })
  $items += $Record
  @($items) | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath $StateFile
}
function Register-TrackedProcess($Name, $Port, $Process) {
  $record = [pscustomobject]@{ name = $Name; port = $Port; pid = $Process.Id; startedAt = $null }
  Save-ProcessRecord $record
  try { $record.startedAt = $Process.StartTime.ToUniversalTime().ToString("O") }
  catch { throw "Could not record process identity for $Name. Verify PID $($Process.Id) manually." }
  Save-ProcessRecord $record
}
try {
  $SkillsRoot = Join-Path $Root "src/skills"
  if ($SkipSkill) {
    Write-Host "Hosted Skills skipped (-SkipSkill)."
  } elseif (Test-Path -LiteralPath $SkillsRoot -PathType Container) {
    $SkillDirs = @(Get-ChildItem -LiteralPath $SkillsRoot -Directory | Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName "host.json") })
    if ($SkillDirs.Count -gt 0) {
      $SingleSkill = ($SkillDirs.Count -eq 1)
      $McpStartScript = Join-Path $PSScriptRoot "lifecycle/mcp-skill-start.ps1"
      for ($SkillIdx = 0; $SkillIdx -lt $SkillDirs.Count; $SkillIdx++) {
        $SkillEntry = $SkillDirs[$SkillIdx]
        $SkillName = $SkillEntry.Name
        $ResolvedSkillPort = if (Get-Command Get-SkillPort -ErrorAction SilentlyContinue) {
          Get-SkillPort $SkillName $SkillIdx $SingleSkill
        } elseif ($env:SKILL_PORT) {
          ([int]$env:SKILL_PORT + $SkillIdx)
        } else {
          (7071 + $SkillIdx)
        }
        $McpArgs = @{
          Name   = $SkillName
          Path   = $SkillEntry.FullName
          Port   = $ResolvedSkillPort
          RunDir = $RunDir
        }
        if ($ForceClean) { $McpArgs["Clean"] = $true }
        & $McpStartScript @McpArgs
        if ($LASTEXITCODE -ne 0) {
          throw "MCP Hosted Skill '$SkillName' failed to start on port $ResolvedSkillPort."
        }
        if ($SkillName -eq "text-insights" -and -not $env:MCP_SKILL_URL) {
          $env:MCP_SKILL_URL = "http://127.0.0.1:$ResolvedSkillPort/runtime/webhooks/mcp"
        }
      }
    }
  }
  $AgentMain = Join-Path $Root "src/agent/main.py"
  if (Test-Path $AgentMain) {
    $AgentDir = Join-Path $Root "src/agent"
    if ($ForceClean -and (Test-Path (Join-Path $AgentDir ".venv"))) {
      Remove-Item -Recurse -Force (Join-Path $AgentDir ".venv")
    }
    Write-Host "Starting backend agent on http://127.0.0.1:$AgentPort ..."
    $env:PORT = "$AgentPort"
    $env:AGENT_PORT = "$AgentPort"
    $agentProc = Start-Process uv `
      -ArgumentList @("run", "main.py") `
      -WorkingDirectory $AgentDir `
      -WindowStyle Hidden `
      -RedirectStandardOutput (Join-Path $RunDir "agent.log") `
      -RedirectStandardError (Join-Path $RunDir "agent.err.log") `
      -PassThru
    Register-TrackedProcess "agent" $AgentPort $agentProc
    $agentReady = $false
    $agentError = "No HTTP response."
    for ($i = 0; $i -lt 120; $i++) {
      if ($agentProc.HasExited) { throw "Backend agent exited before opening port $AgentPort" }
      try {
        $resp = Invoke-WebRequest -Uri "http://127.0.0.1:$AgentPort/healthz" -UseBasicParsing -SkipHttpErrorCheck -TimeoutSec 2
        if ($resp.StatusCode -eq 200) {
          Write-Host "Backend agent ready on http://127.0.0.1:$AgentPort"
          $agentReady = $true
          break
        }
        $agentError = "HTTP $($resp.StatusCode)"
      } catch [System.Net.Http.HttpRequestException] { $agentError = $_.Exception.Message }
        catch [System.Threading.Tasks.TaskCanceledException] { $agentError = $_.Exception.Message }
      Start-Sleep -Milliseconds 150
    }
    if (-not $agentReady) { throw "Backend agent did not become ready on port $AgentPort`: $agentError" }
  }

  if ($ForceClean -and (Test-Path (Join-Path $Root ".venv"))) {
    Remove-Item -Recurse -Force (Join-Path $Root ".venv")
  }
  Write-Host "Starting __APP_NAME__ (App Service Builder + AI Gateway) on http://127.0.0.1:$WebPort ..."
  $proc = Start-Process uv `
    -ArgumentList @("run", "python", "-m", "uvicorn", "app:create_app", "--factory", "--host", "127.0.0.1", "--port", "$WebPort", "--no-access-log", "--log-level", "warning") `
    -WorkingDirectory $Root `
    -WindowStyle Hidden `
    -RedirectStandardOutput (Join-Path $RunDir "web.log") `
    -RedirectStandardError (Join-Path $RunDir "web.err.log") `
    -PassThru

  Register-TrackedProcess "web" $WebPort $proc

  $webError = "No HTTP response."
  for ($i = 0; $i -lt 120; $i++) {
    if ($proc.HasExited) { throw "App Service Builder AI Gateway app exited before opening port $WebPort" }
    try {
      $response = Invoke-WebRequest -Uri "http://127.0.0.1:$WebPort/health" -UseBasicParsing -SkipHttpErrorCheck -TimeoutSec 2
      if ($response.StatusCode -eq 200) {
        Write-Host "App Service Builder AI Gateway app ready on http://127.0.0.1:$WebPort"
        exit 0
      }
      $webError = "HTTP $($response.StatusCode)"
    } catch [System.Net.Http.HttpRequestException] { $webError = $_.Exception.Message }
      catch [System.Threading.Tasks.TaskCanceledException] { $webError = $_.Exception.Message }
    Start-Sleep -Milliseconds 150
  }

  throw "App Service Builder AI Gateway app did not become ready on port $WebPort`: $webError"
} catch {
  & (Join-Path $PSScriptRoot "dev-stop.ps1")
  throw
}
