#!/usr/bin/env bash
set -euo pipefail

for candidate_bin in \
  "/opt/homebrew/bin" \
  "/usr/local/bin" \
  "$HOME/.local/bin" \
  $(ls -d "$HOME/.nvm/versions/node/"*/bin 2>/dev/null | sort -V | tail -n 1); do
  if [[ -n "$candidate_bin" && -d "$candidate_bin" && ":$PATH:" != *":$candidate_bin:"* ]]; then
    export PATH="$candidate_bin:$PATH"
  fi
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_DIR="$ROOT/.dev-run"
. "$ROOT/scripts/load-ports.sh"
load_app_ports "$ROOT"
WEB_PORT="${WEB_PORT:-8080}"
AGENT_PORT="${AGENT_PORT:-8088}"
SKILL_PORT="${SKILL_PORT:-7071}"
SKIP_SKILL=0
FORCE_CLEAN="${FORCE_CLEAN:-0}"
while (($#)); do
  case "$1" in
    --skip-skill) SKIP_SKILL=1 ;;
    --clean|-Clean) FORCE_CLEAN=1 ;;
    --help|-h)
      echo "Usage: ./scripts/dev-start.sh [--skip-skill] [--clean]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if ! "$ROOT/scripts/dev-stop.sh"; then
  echo "The previous app processes could not be stopped safely." >&2
  exit 1
fi
mkdir -p "$RUN_DIR"
: >"$RUN_DIR/processes.posix.tsv"

record_process() {
  local name="$1" port="$2" pid="$3" started_at
  started_at="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" || started_at=""
  printf '%s\t%s\t%s\t%s\n' "$name" "$port" "$pid" "$started_at" >>"$RUN_DIR/processes.posix.tsv"
  if [[ -z "$started_at" ]]; then
    echo "Could not record process identity for $name. Verify PID $pid manually." >&2
    return 1
  fi
}

index_url="${PIP_INDEX_URL:-${UV_INDEX_URL:-${UV_DEFAULT_INDEX:-}}}"
if [[ -n "$index_url" ]]; then
  export PIP_INDEX_URL="$index_url" UV_INDEX_URL="$index_url" UV_DEFAULT_INDEX="$index_url"
fi

if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ROOT/.env"
  set +a
elif [ -f "$ROOT/src/agent/.env" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ROOT/src/agent/.env"
  set +a
fi

if ((SKIP_SKILL)); then
  echo "Hosted Skills skipped (--skip-skill)."
elif [ -d "$ROOT/src/skills" ]; then
  skill_dirs=()
  skill_count=0
  for candidate_dir in "$ROOT"/src/skills/*; do
    if [ -d "$candidate_dir" ] && [ -f "$candidate_dir/host.json" ]; then
      skill_dirs+=("$candidate_dir")
      skill_count=$((skill_count + 1))
    fi
  done
  if ((skill_count > 0)); then
    single_skill=0
    ((skill_count == 1)) && single_skill=1
    skill_idx=0
    for skill_dir in ${skill_dirs[@]+"${skill_dirs[@]}"}; do
      skill_name="$(basename "$skill_dir")"
      if declare -F skill_port_for_name >/dev/null 2>&1; then
        resolved_skill_port="$(skill_port_for_name "$skill_name" "$skill_idx" "$single_skill")"
      else
        resolved_skill_port="$((SKILL_PORT + skill_idx))"
      fi
      clean_arg=()
      [[ "$FORCE_CLEAN" == "1" ]] && clean_arg=(--clean)
      if ! "$ROOT/scripts/lifecycle/mcp-skill-start.sh" \
        --name "$skill_name" \
        --path "$skill_dir" \
        --port "$resolved_skill_port" \
        --run-dir "$RUN_DIR" \
        ${clean_arg[@]+"${clean_arg[@]}"}; then
        "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
        exit 1
      fi
      if [[ "$skill_name" == "text-insights" && -z "${MCP_SKILL_URL:-}" ]]; then
        export MCP_SKILL_URL="http://127.0.0.1:$resolved_skill_port/runtime/webhooks/mcp"
      fi
      skill_idx=$((skill_idx + 1))
    done
  fi
fi

if [ -f "$ROOT/src/agent/main.py" ]; then
  if [[ "$FORCE_CLEAN" == "1" && -d "$ROOT/src/agent/.venv" ]]; then
    rm -rf "$ROOT/src/agent/.venv"
  fi
  if ! (cd "$ROOT/src/agent" && uv sync); then
    "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
    exit 1
  fi
  echo "Starting backend agent on http://127.0.0.1:$AGENT_PORT ..."
  (
    cd "$ROOT/src/agent"
    UV_NO_SYNC=1 PORT="$AGENT_PORT" AGENT_PORT="$AGENT_PORT" uv run main.py >"$RUN_DIR/agent.log" 2>&1
  ) &
  agent_pid=$!
  record_process "agent" "$AGENT_PORT" "$agent_pid"
  agent_ready=0
  for _ in $(seq 1 120); do
    if ! kill -0 "$agent_pid" 2>/dev/null; then
      echo "Backend agent exited before becoming ready on port $AGENT_PORT. Recent log output:" >&2
      tail -n 40 "$RUN_DIR/agent.log" >&2 || true
      "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
      exit 1
    fi
    if curl -fsS "http://127.0.0.1:$AGENT_PORT/healthz" >/dev/null 2>&1 || curl -fsS "http://127.0.0.1:$AGENT_PORT/api/runtime" >/dev/null 2>&1; then
      echo "Backend agent ready on http://127.0.0.1:$AGENT_PORT"
      agent_ready=1
      break
    fi
    sleep 0.15
  done
  if [[ "$agent_ready" != "1" ]]; then
    echo "Backend agent did not become ready on port $AGENT_PORT. Recent log output:" >&2
    tail -n 40 "$RUN_DIR/agent.log" >&2 || true
    "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
    exit 1
  fi
fi

if [[ "$FORCE_CLEAN" == "1" && -d "$ROOT/.venv" ]]; then
  rm -rf "$ROOT/.venv"
fi
if ! (cd "$ROOT" && uv sync); then
  "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
  exit 1
fi
echo "Starting __APP_NAME__ (App Service Builder + AI Gateway) on http://127.0.0.1:$WEB_PORT ..."
(
  cd "$ROOT"
  UV_NO_SYNC=1 uv run python -m uvicorn app:create_app --factory --host 127.0.0.1 --port "$WEB_PORT" --no-access-log --log-level warning >"$RUN_DIR/web.log" 2>&1
) &
web_pid=$!
record_process "web" "$WEB_PORT" "$web_pid"

for _ in $(seq 1 120); do
  if ! kill -0 "$web_pid" 2>/dev/null; then
    echo "App Service Builder AI Gateway app exited before becoming ready on port $WEB_PORT. Recent log output:" >&2
    tail -n 40 "$RUN_DIR/web.log" >&2 || true
    "$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
    exit 1
  fi
  if curl -fsS "http://127.0.0.1:$WEB_PORT/health" >/dev/null 2>&1 || curl -fsS "http://127.0.0.1:$WEB_PORT" >/dev/null 2>&1; then
    echo "App Service Builder AI Gateway app ready on http://127.0.0.1:$WEB_PORT"
    exit 0
  fi
  sleep 0.15
done

echo "App Service Builder AI Gateway app did not become ready on port $WEB_PORT. Recent log output:" >&2
tail -n 40 "$RUN_DIR/web.log" >&2 || true
"$ROOT/scripts/dev-stop.sh" || echo "Process cleanup is incomplete." >&2
exit 1
