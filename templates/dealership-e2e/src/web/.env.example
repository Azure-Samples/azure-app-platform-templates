# Base URL for the live deal-finder agent server (ResponsesHostServer). Only
# used server-side (Next.js route handlers), never sent to the browser.
# Defaults to http://127.0.0.1:8088 if unset. When unreachable, /api/chat
# returns source="agent_error" with startup guidance.
AGENT_URL=http://127.0.0.1:8088
# Maximum time for a live agent turn, including Hosted Skills/model calls.
AGENT_TIMEOUT_MS=120000
